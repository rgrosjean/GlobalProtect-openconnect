      <property name="styleSheet">
       <string notr="true">/* The accent of the primary button: the only fixed colour besides the shields,
   chosen to keep white text readable on light and dark palettes. */
#connectButton {
    background-color: #2a6bd8;
    color: white;
    border: 1px solid #2159b8;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
}
#connectButton:hover {
    background-color: #3a7be8;
}
#connectButton:focus {
    border: 2px solid palette(window-text);
}
#connectButton:pressed {
    background-color: #2159b8;
}
#connectButton:disabled {
